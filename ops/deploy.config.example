# Copy to ops/deploy.config and fill in real values.

SSH_USER=root
SSH_PORT=22
SSH_KEY=
REMOTE_DIR=/root/service/anti_pro

# Two staging servers
STAGING_EXTERNAL_HOST=
STAGING_INTERNAL_HOST=

# Two production servers
PRODUCTION_EXTERNAL_HOST=
PRODUCTION_INTERNAL_HOST=

# Env files already stored on each server.
STAGING_EXTERNAL_ENV=./cursor_sh/backend/.env.staging.external
STAGING_INTERNAL_ENV=./cursor_sh/backend/.env.staging.internal
PRODUCTION_EXTERNAL_ENV=./cursor_sh/backend/.env.production.external
PRODUCTION_INTERNAL_ENV=./cursor_sh/backend/.env.production.internal

# Optional frontend port binding.
# Staging external is often tested directly by IP, so release.sh defaults it
# to 80:8080. Production defaults to 127.0.0.1:8080:8080 for host-level Caddy.
# STAGING_EXTERNAL_FRONTEND_PORT_BIND=80:8080
# STAGING_INTERNAL_FRONTEND_PORT_BIND=80:8080
# PRODUCTION_EXTERNAL_FRONTEND_PORT_BIND=127.0.0.1:8080:8080
# PRODUCTION_INTERNAL_FRONTEND_PORT_BIND=127.0.0.1:8080:8080
