# ======================================
# 用户端部署配置 (.env.external)
# 部署在面向客户的 ECS 上
# ======================================

# 部署模式
DEPLOYMENT_MODE=external

# ===== 数据库（RDS MySQL） =====
DB_TYPE=mysql
DB_HOST=rm-xxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=unique_video
DB_USER=uv_user
DB_PASSWORD=your_strong_password
DB_POOL_SIZE=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# 审计日志独立库
AUDIT_DATABASE_URL=mysql+aiomysql://uv_user:password@rm-xxxxx:3306/unique_video_audit

# ===== 安全密钥（两端必须一致！） =====
SECRET_KEY=your_production_secret_key
JWT_SECRET_KEY=your_production_jwt_secret_key

# ===== CORS =====
CORS_ORIGINS=https://your-domain.com

# ===== 文件存储（OSS） =====
OSS_ENABLED=true
OSS_ACCESS_KEY_ID=LTAI5t...
OSS_ACCESS_KEY_SECRET=...
OSS_BUCKET_NAME=unique-video-files
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com

# ===== AI 大模型 =====
AI_API_KEY=sk-...
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gpt-4
AGENT_MODE=brand

# ===== SMS 短信 =====
SMS_ENABLED=true
SMS_ACCESS_KEY_ID=...
SMS_ACCESS_KEY_SECRET=...
SMS_SIGN_NAME=...
SMS_TEMPLATE_CODE=...

# ===== 通用 =====
DEBUG=false
HOST=0.0.0.0
PORT=8000
