# ======================================================================
# 用户端部署配置（面向客户）
# 部署在 external ECS 上，直接复制此文件为 .env 并填入真实值即可
# ======================================================================

# ======================== 应用基础 ========================
APP_NAME=AI设计任务管理系统
APP_VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ======================== 安全密钥 ========================
# ⚠️ 必须修改！且必须和 internal 端完全一致！
SECRET_KEY=和internal端一模一样的值
JWT_SECRET_KEY=和internal端一模一样的值
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ======================== 部署模式 ========================
DEPLOYMENT_MODE=external
WEB_CONCURRENCY=4

# ======================== CORS 跨域 ========================
# 填 external ECS 的公网IP或域名
CORS_ORIGINS=http://external服务器的公网IP

# ======================== 数据库（RDS MySQL） ========================
# ⚠️ 必须和 internal 端连同一个 RDS 数据库！
DB_TYPE=mysql
DB_HOST=和internal一样的RDS内网地址.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=和internal一样的数据库名
DB_USER=和internal一样的RDS用户名
DB_PASSWORD=和internal一样的RDS密码
DB_CHARSET=utf8mb4

# 连接池
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True

# 审计日志独立库（和 internal 连同一个审计库）
AUDIT_DATABASE_URL=mysql+aiomysql://用户名:密码@RDS内网地址:3306/审计库名?charset=utf8mb4

# ======================== 阿里云 OSS 文件存储 ========================
OSS_ENABLED=True
OSS_ACCESS_KEY_ID=和internal一样的AccessKeyID
OSS_ACCESS_KEY_SECRET=和internal一样的AccessKeySecret
OSS_BUCKET_NAME=和internal一样的Bucket名称
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
OSS_SIGNED_URL_EXPIRES=3600

# ======================== 短信验证码（阿里云号码认证服务） ========================
# 用于客户注册、登录、找回密码
SMS_ENABLED=True
SMS_ACCESS_KEY_ID=和internal一样的AccessKeyID
SMS_ACCESS_KEY_SECRET=和internal一样的AccessKeySecret
SMS_SIGN_NAME=和internal一样的短信签名
SMS_TEMPLATE_CODE=和internal一样的模板CODE
SMS_CODE_LENGTH=6
SMS_VALID_TIME=300

# ======================== 邮件服务 ========================
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USER=service@uniquevisionx.com
SMTP_PASSWORD=你的阿里企业邮箱密码或三方客户端安全密码
SMTP_FROM=service@uniquevisionx.com
SMTP_FROM_NAME=Unique Vision AI

# ======================== AI 大模型 ========================
# ⚠️ external 端必须配置！客户的 AI 对话、需求收集全靠它
AI_API_KEY=你的大模型APIKey
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL_NAME=qwen-plus
AI_HTTP_TIMEOUT=30
DOCUMENT_EXTRACT_MODEL=qwen3.7-max
DOCUMENT_EXTRACT_TIMEOUT=180
DOCUMENT_EXTRACT_CHUNK_CHARS=18000
DOCUMENT_EXTRACT_MAX_TOTAL_CHARS=120000
AI_MAX_CONCURRENT_REQUESTS=4
AI_REQUEST_QUEUE_TIMEOUT=5
AI_BACKGROUND_MAX_CONCURRENT=2
AI_CRAWL_MAX_CONCURRENT=1
AI_CRAWL_PENDING_TTL_SECONDS=1800
STARTUP_DB_LOCK_TIMEOUT=60
AGENT_MODE=media

# ======================== 初始管理员账户 ========================
# external 端不需要管理员，但保持和 internal 一致即可
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=和internal一样的密码
INIT_ADMIN_EMAIL=和internal一样的邮箱
INIT_ADMIN_PHONE=和internal一样的手机号

# ======================== 日志系统 ========================
LOG_ENABLED=True
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_ROTATION=50 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=gz
LOG_DB_ENABLED=True
LOG_DB_METHODS=POST,PUT,DELETE
LOG_DB_QUEUE_SIZE=1000
LOG_DB_WORKERS=2
LOG_SANITIZE_FIELDS=password,oldPassword,newPassword,old_password,new_password,token,secret,sms_code,captcha,invite_token
LOG_MAX_PAYLOAD_SIZE=4096
LOG_MODULES=Auth,Workspace,Order,AI,Staff,Notification,Contractor,System

# ======================== API 限流 ========================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# ======================== 文件上传 ========================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,application/zip,application/pdf
