# ======================================
# 内部系统部署配置 (.env.internal)
# 部署在管理员+承包商的 ECS 上
# ======================================

# 部署模式
DEPLOYMENT_MODE=internal

# ===== 数据库（同一个 RDS，内网互通） =====
DB_TYPE=mysql
DB_HOST=rm-xxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=unique_video
DB_USER=uv_user
DB_PASSWORD=your_strong_password
DB_POOL_SIZE=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# 审计日志独立库
AUDIT_DATABASE_URL=mysql+aiomysql://uv_user:password@rm-xxxxx:3306/unique_video_audit

# ===== 安全密钥（两端必须一致！） =====
SECRET_KEY=your_production_secret_key
JWT_SECRET_KEY=your_production_jwt_secret_key

# ===== CORS =====
CORS_ORIGINS=https://internal.your-domain.com

# ===== 文件存储（同一个 OSS Bucket） =====
OSS_ENABLED=true
OSS_ACCESS_KEY_ID=LTAI5t...
OSS_ACCESS_KEY_SECRET=...
OSS_BUCKET_NAME=unique-video-files
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com

# ===== 承包商邀请链接 =====
CONTRACTOR_BASE_URL=https://internal.your-domain.com

# ===== 管理员初始账户 =====
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change_this_password
INIT_ADMIN_EMAIL=admin@your-domain.com
INIT_ADMIN_PHONE=13800000000

# ===== 通用 =====
DEBUG=false
HOST=0.0.0.0
PORT=8000
