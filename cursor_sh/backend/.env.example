# 应用配置
APP_NAME=Unique Vision AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
API_DOCS_ENABLED=False
INIT_SAMPLE_STAFF=False

# 服务器配置
HOST=0.0.0.0
PORT=8000

# ========== 数据库配置 ==========
# 方式1: 直接指定完整连接串（设置后忽略下方 DB_* 字段）
# DATABASE_URL=mysql+aiomysql://user:pass@rm-xxx.mysql.rds.aliyuncs.com:3306/dbname?charset=utf8mb4

# 方式2: 结构化配置（推荐，当 DATABASE_URL 为空时生效）
DB_TYPE=sqlite
# DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=app
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# 连接池配置（仅 MySQL/RDS 生效）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
AUTO_CREATE_TABLES=False

# 审计日志独立数据库（与主业务库物理隔离）
# 生产环境必须配置到 RDS/MySQL；开发环境可继续使用 SQLite
AUDIT_DATABASE_URL=sqlite+aiosqlite:///./audit.db
# AUDIT_DATABASE_URL=mysql+aiomysql://audit_user:audit_pass@rm-xxx.mysql.rds.aliyuncs.com:3306/audit_db?charset=utf8mb4

# JWT 配置
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# 官网访问 IP 属地（离线 ip2region 数据库）
IP_GEO_DATABASE_PATH=data/ip2region_v4.xdb
IP_GEO_MANUAL_BATCH_LIMIT=200
IP_GEO_CACHE_LIMIT=10000

# CORS 配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=209715200
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,application/zip,application/pdf

# 阿里云 OSS 配置（私有 Bucket + 签名 URL）
OSS_ENABLED=False
OSS_ACCESS_KEY_ID=your-aliyun-ak
OSS_ACCESS_KEY_SECRET=your-aliyun-sk
OSS_BUCKET_NAME=your-bucket-name
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_SIGNED_URL_EXPIRES=3600

# 阿里云短信服务（Dysmsapi）
SMS_ENABLED=False
SMS_ACCESS_KEY_ID=your-aliyun-ak
SMS_ACCESS_KEY_SECRET=your-aliyun-sk
SMS_SIGN_NAME=你的短信签名
SMS_TEMPLATE_CODE=你的短信模板CODE(如SMS_123456)
SMS_REGION_ID=cn-qingdao
SMS_CODE_LENGTH=6
SMS_VALID_TIME=300

# 邮件配置
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USER=support@uniquevisionx.com
SMTP_PASSWORD=your-aliyun-mail-password-or-security-password
SMTP_FROM=support@uniquevisionx.com
SMTP_FROM_NAME=Unique Vision AI
SMTP_TIMEOUT=20

# 外部服务重试配置
EXTERNAL_API_RETRY_ATTEMPTS=3
EXTERNAL_API_RETRY_INITIAL_DELAY=0.5
EXTERNAL_API_RETRY_MAX_DELAY=3
OSS_RETRY_ATTEMPTS=3
SMS_RETRY_ATTEMPTS=2
EMAIL_RETRY_ATTEMPTS=2
AI_RETRY_ATTEMPTS=2

# API 限流配置
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# 初始管理员账户（部署时请修改）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=123456
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PHONE=13800000000
# 额外初始管理员（JSON 数组，启动时幂等创建；已有账号不会覆盖密码）
INIT_ADDITIONAL_ADMINS=[]

# ========== 大模型配置 (阿里云百炼/通义千问) ==========
AI_API_KEY=你的千问API_KEY
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL_NAME=qwen3.7-plus
AI_HTTP_TIMEOUT=30
AI_REQUIREMENT_TEMPERATURE=0.3
AI_CREATIVE_DIRECTION_TIMEOUT=120
AI_CREATIVE_DIRECTION_RETRY_ATTEMPTS=1
DOCUMENT_EXTRACT_MODEL=qwen3.7-max
DOCUMENT_EXTRACT_TIMEOUT=180
DOCUMENT_EXTRACT_CHUNK_CHARS=18000
DOCUMENT_EXTRACT_MAX_TOTAL_CHARS=120000
AI_MAX_CONCURRENT_REQUESTS=4
AI_REQUEST_QUEUE_TIMEOUT=5
AI_BACKGROUND_MAX_CONCURRENT=2
AI_CRAWL_MAX_CONCURRENT=1
AI_CRAWL_PENDING_TTL_SECONDS=1800
STARTUP_DB_LOCK_TIMEOUT=60

# ========== Hermes Agent（管理员创意工作台） ==========
# Hermes 侧需配置 API_SERVER_ENABLED=true / API_SERVER_KEY，并启动 hermes gateway
HERMES_AGENT_ENABLED=False
HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=change-me-local-dev
HERMES_HTTP_TIMEOUT=180
HERMES_CREATIVE_PROFILE=creative-orchestrator
HERMES_CREATIVE_MODEL=qwen3.7-max
HERMES_CREATIVE_SKILLS_DIR=./hermes_skills
HERMES_CREATIVE_REQUIRED_TOOLSETS=skills,code_execution,memory,session_search
HERMES_CREATIVE_BACKGROUND_TIMEOUT=1200
HERMES_CREATIVE_POLL_INTERVAL=2

# ========== 部署模式 ==========
# all = 全量（开发用），external = 用户端，internal = 内部系统（管理员+承包商）
DEPLOYMENT_MODE=all
WEB_CONCURRENCY=4
# 承包商端基础 URL（用于邀请链接）
CONTRACTOR_BASE_URL=https://contractor.uniquevisionx.com
# 用户端官网基础 URL（用于用户邀请链接）
USER_SITE_BASE_URL=https://www.uniquevisionx.com
# 是否放开普通用户注册；内测阶段建议 false，false 时必须通过用户邀请链接注册
ALLOW_OPEN_USER_REGISTRATION=false

# ========== 日志配置 ==========
LOG_ENABLED=True
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_ROTATION=50 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=gz
LOG_DB_ENABLED=True
LOG_DB_METHODS=POST,PUT,DELETE
LOG_DB_QUEUE_SIZE=1000
LOG_DB_WORKERS=2
LOG_SANITIZE_FIELDS=password,oldPassword,newPassword,old_password,new_password,token,secret,sms_code,captcha
LOG_MAX_PAYLOAD_SIZE=4096
LOG_MODULES=Auth,Workspace,Order,AI,Staff,Notification,System
